{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alwaysfoundation.org/spec/v0.1/handoff-standard.schema.json",
  "title": "Always Pathway standard v0.1 (formerly the Always Handoff standard)",
  "description": "Open standard for passing a consenting person from a sending ministry to a receiving church in Australia. Text CC BY 4.0. Draws on ISO/IEC TS 27560 (consent), HL7 FHIR ServiceRequest/Task (lifecycle) and Open Referral HSDS (directory).",
  "$defs": {
    "AgeBand": { "enum": ["under13", "13-14", "15-17", "18+"] },
    "StepCategory": { "enum": ["church", "explore", "talk", "youth", "group", "help", "read"] },
    "Organisation": {
      "type": "object",
      "required": ["id", "kind", "displayName", "trustLevel", "state"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "kind": { "enum": ["church", "ministry", "network"] },
        "displayName": { "type": "string", "maxLength": 160 },
        "denomination": { "type": "string" },
        "category": { "type": "string" },
        "trustLevel": { "enum": ["listed", "claimed", "verified", "verified_youth"] },
        "suburb": { "type": "string" },
        "state": { "enum": ["NSW", "VIC", "QLD", "WA", "SA", "TAS", "ACT", "NT"] },
        "postcode": { "type": "string", "pattern": "^[0-9]{4}$" },
        "location": { "$ref": "#/$defs/GeoPoint" },
        "website": { "type": "string", "format": "uri" },
        "offers": { "type": "array", "items": { "$ref": "#/$defs/StepCategory" } },
        "lastConfirmedAt": { "type": "string", "format": "date-time" },
        "source": { "type": "object", "properties": { "url": { "type": "string", "format": "uri" }, "date": { "type": "string", "format": "date" } } }
      }
    },
    "GeoPoint": { "type": "object", "required": ["lat", "lng"], "properties": { "lat": { "type": "number", "minimum": -44, "maximum": -9 }, "lng": { "type": "number", "minimum": 112, "maximum": 154 } } },
    "Consent": {
      "type": "object",
      "required": ["id", "purposes", "recipients", "wordingVersion", "party", "ageBand", "collectedAt"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "purposes": { "type": "array", "minItems": 1, "items": { "enum": ["connect.church", "notify.sender", "resources", "stats.anonymous"] } },
        "recipients": { "type": "array", "items": { "type": "string", "format": "uuid" } },
        "allowNextNearby": { "type": "boolean", "default": false },
        "wordingVersion": { "type": "string" },
        "party": { "enum": ["self", "parent"] },
        "ageBand": { "$ref": "#/$defs/AgeBand" },
        "collectedAt": { "type": "string", "format": "date-time" },
        "parentConfirmedAt": { "type": "string", "format": "date-time" },
        "withdrawnAt": { "type": "string", "format": "date-time" }
      }
    },
    "Response": {
      "type": "object",
      "required": ["ageBand", "step", "consent"],
      "properties": {
        "firstName": { "type": "string", "maxLength": 60, "description": "Restricted. Omitted for under-13s (parent details only)." },
        "contact": { "type": "object", "properties": { "mobile": { "type": "string", "pattern": "^\\+?61[0-9]{9}$|^0[0-9]{9}$" }, "email": { "type": "string", "format": "email" } }, "description": "Restricted. One method." },
        "suburb": { "type": "string" },
        "postcode": { "type": "string", "pattern": "^[0-9]{4}$" },
        "ageBand": { "$ref": "#/$defs/AgeBand" },
        "step": { "$ref": "#/$defs/StepCategory" },
        "language": { "type": "string" },
        "campaignId": { "type": "string", "format": "uuid" },
        "placementId": { "type": "string", "format": "uuid" },
        "consent": { "$ref": "#/$defs/Consent" }
      },
      "allOf": [
        { "if": { "properties": { "ageBand": { "const": "under13" } } }, "then": { "not": { "required": ["firstName"] } } }
      ]
    },
    "HandoffEvent": {
      "type": "object",
      "description": "CloudEvents 1.0 envelope; data carries status only, never personal details.",
      "required": ["specversion", "type", "source", "id", "time", "data"],
      "properties": {
        "specversion": { "const": "1.0" },
        "type": { "enum": ["handoff.offered", "handoff.accepted", "handoff.passed", "handoff.expired", "handoff.rerouted", "handoff.status_changed", "consent.withdrawn", "person.deleted", "organisation.verified", "organisation.suspended"] },
        "source": { "type": "string" },
        "id": { "type": "string" },
        "time": { "type": "string", "format": "date-time" },
        "data": {
          "type": "object",
          "properties": {
            "handoffId": { "type": "string", "format": "uuid" },
            "orgId": { "type": "string", "format": "uuid" },
            "state": { "enum": ["awaiting_parent", "routing", "offered", "accepted", "contacted", "care_team", "closed", "withdrawn"] },
            "status": { "enum": ["contacted", "met_up", "came_on_sunday", "joined_group", "not_ready", "asked_to_stop"] },
            "passReason": { "enum": ["capacity", "language", "fit", "safeguarding", "other"] }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
