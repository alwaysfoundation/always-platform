{
  "name": "always-platform",
  "private": true,
  "version": "3.0.0",
  "description": "The Always network: consented handoff from response to a verified local church, for Australia.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed-dev.ts",
    "import:directory": "tsx scripts/import-directory.ts",
    "test": "vitest run",
    "test:db": "vitest run --dir apps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test",
    "import:events": "tsx scripts/import-events.ts",
    "build:api": "mkdir -p public && esbuild apps/api/src/vercel.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/api.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --log-level=warning",
    "ai:modelfile": "tsx packages/ai/src/write-modelfile.ts",
    "ai:eval": "tsx packages/ai/src/run.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "aws4fetch": "^1.0.20",
    "hono": "^4.6.14",
    "jose": "^5.10.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "overrides": {
    "postcss": "^8.5.33"
  }
}
