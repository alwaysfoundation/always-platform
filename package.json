{
  "name": "always-platform",
  "private": true,
  "version": "0.1.0",
  "description": "The Always network: consented handoff from response to a verified local church, for Australia.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed-dev.ts",
    "import:directory": "tsx scripts/import-directory.ts",
    "test": "vitest run",
    "test:db": "vitest run --dir apps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test",
    "import:events": "tsx scripts/import-events.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.19",
    "hono": "^4.13.18",
    "jose": "^5.10.0",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  }
}
