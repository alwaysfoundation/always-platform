# Copy to .env.local for development. Never commit real values.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/always
# 32 random bytes, base64 (openssl rand -base64 32). Production keys come from AWS KMS ap-southeast-2.
FIELD_KEY=
HASH_KEY=
# Local auth (HS256). Production uses Supabase Auth JWKS instead:
AUTH_JWT_SECRET=
# AUTH_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
CRON_SECRET=
APP_URL=http://localhost:3000
PERSON_URL=http://localhost:3000/p
REGION=local
# Production delivery (leave empty locally to log template ids only)
# RESEND_API_KEY=re_...   # transactional email (partner alerts, onboarding)
# EMAIL_FROM=hello@alwaysfoundation.org
# SMS_API_URL=
# SMS_API_KEY=
# SMS_SENDER_ID=Always
