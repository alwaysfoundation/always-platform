# Copy to .env.local for development. Never commit real values.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/always
# 32 random bytes, base64 (openssl rand -base64 32). Production keys come from AWS KMS ap-southeast-2.
FIELD_KEY=
HASH_KEY=
# Local auth (HS256). Production uses Supabase Auth JWKS instead:
AUTH_JWT_SECRET=
# AUTH_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
CRON_SECRET=
APP_URL=http://localhost:3000
# Public base URL of this API, used in links that people open from email
API_URL=http://localhost:8787
PERSON_URL=http://localhost:3000/p
REGION=local
# Production delivery (leave empty locally to log template ids only)
# Email: Amazon SES in Sydney (ap-southeast-2) or Melbourne (ap-southeast-4) only.
# SES_REGION=ap-southeast-2
# SES_ACCESS_KEY_ID=          # IAM user limited to ses:SendEmail
# SES_SECRET_ACCESS_KEY=
# SES_CONFIGURATION_SET=      # optional
# EMAIL_FROM=Always <hello@alwaysfoundation.org>
# SMS_API_URL=
# SMS_API_KEY=
# SMS_SENDER_ID=Always

# Invisible human check on public forms (hosted response pages, event suggestions)
# TURNSTILE_SECRET=
# TURNSTILE_SITE_KEY=
