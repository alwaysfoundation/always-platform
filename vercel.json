{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:api",
  "outputDirectory": "public",
  "regions": ["syd1"],
  "functions": { "api/index.js": { "maxDuration": 30 } },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
